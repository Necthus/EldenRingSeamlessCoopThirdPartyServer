# Publish an explicit source/documentation allowlist from this working folder.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/selfhost/
!/docs/
!/server/

/selfhost/*
!/selfhost/NetworkLauncher.UI.cs
!/selfhost/SaveManager.cs
!/selfhost/SaveManager.UI.cs
!/selfhost/ModHttpGuard.cs
!/selfhost/BroadcastAddresses.cs
!/selfhost/launcher-ui.manifest
!/selfhost/build-launcher-ui.ps1
!/selfhost/build-release.py
!/selfhost/publish-release.py
!/selfhost/LauncherUI.Tests.cs
!/selfhost/LauncherLayout.Tests.cs
!/selfhost/HttpGuard.Tests.cs
!/selfhost/SaveManager.Tests.cs

/docs/*
!/docs/architecture.md
!/docs/save-manager.md
!/docs/mod-network-checks.md
!/docs/testing.md
!/docs/attribution.md
!/docs/release-install.md
!/docs/release-v0.1.0.md
!/docs/release-v0.1.1.md

/server/*
!/server/README.md
!/server/ersc-vps.conf.example
!/server/player.conf.example
!/server/custom_broadcasts.txt.example
!/server/install-vps.sh

# Defense in depth for generated binaries, local configs and credentials.
*.exe
*.dll
*.pdb
*.zip
*.dmp
*.sl2*
*.co2*
*.conf
*.key
*.pem
*.log
*.tmp
__pycache__/
